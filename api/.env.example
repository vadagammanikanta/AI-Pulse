# ── Required ────────────────────────────────────────────────────────────────
API_SECRET_KEY=changeme-at-least-32-characters-long

# SQLite DB (relative to where uvicorn is started, i.e. api/)
DATABASE_URL=sqlite+aiosqlite:///./data/aipulse.db

# ── LLM providers (set the ones you have; omit the rest) ────────────────────
# Priority order: GROQ → GEMINI → OLLAMA (first with valid key wins)

# Groq (free tier)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant
GROQ_RPM=30
GROQ_DAILY_LIMIT=14400

# Gemini (free tier)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash
GEMINI_RPM=15
GEMINI_DAILY_LIMIT=1500

# Ollama (local fallback — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_RPM=60
OLLAMA_DAILY_LIMIT=999999

# ── Embeddings (local, no API cost) ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384

# ── Pipeline behaviour ───────────────────────────────────────────────────────
TOP_N_PER_RUN=20
PRE_SCORE_THRESHOLD=40
LLM_BATCH_SIZE=4
PIPELINE_INTERVAL_HOURS=6
FILTERED_LOG_MAX_ENTRIES=200

# ── Telegram (optional) ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_CHAT_ID=123456789

# ── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
